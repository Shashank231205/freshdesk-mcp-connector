    {
      "name": "search_contacts",
      "description": "Find contacts by exact email, phone, mobile, company id or tag.",
      "inputSchema": {
        "$defs": {
          "ContactSearch": {
            "description": "Structured contact filters. All given filters must match.",
            "properties": {
              "email": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "^[^'\\\"\\\\]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Exact email address.",
                "title": "Email"
              },
              "phone": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "^[^'\\\"\\\\]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Exact phone, as stored.",
                "title": "Phone"
              },
              "mobile": {
                "anyOf": [
                  {
                    "maxLength": 100,
