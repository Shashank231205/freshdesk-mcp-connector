    {
      "name": "search_tickets",
      "description": "Find tickets by status, priority, tag, type, agent, group or date range.\n\n        All filters must match. Dates are inclusive. Freshdesk caps search at 300 results.\n        ",
      "inputSchema": {
        "$defs": {
          "TicketSearch": {
            "description": "Structured ticket filters. All given filters must match.",
            "properties": {
              "status": {
                "anyOf": [
                  {
                    "items": {
                      "enum": [
                        "open",
                        "pending",
                        "resolved",
                        "closed"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Any of these statuses.",
                "title": "Status"
              },
              "priority": {
                "anyOf": [
                  {
                    "items": {
                      "enum": [
                        "low",
                        "medium",
                        "high",
                        "urgent"
                      ],
                      "type": "string"
                    },
                    "type": "array"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Any of these priorities.",
                "title": "Priority"
              },
              "tag": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "^[^'\\\"\\\\]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Exact tag, e.g. 'refund'.",
                "title": "Tag"
              },
              "type": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "minLength": 1,
                    "pattern": "^[^'\\\"\\\\]+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Exact ticket type, e.g. 'Problem'.",
                "title": "Type"
              },
              "agent_id": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Assigned agent id.",
                "title": "Agent Id"
              },
              "group_id": {
                "anyOf": [
                  {
                    "exclusiveMinimum": 0,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Assigned group id.",
                "title": "Group Id"
              },
              "created_from": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Created on or after (UTC).",
                "title": "Created From"
              },
              "created_to": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Created on or before (UTC).",
                "title": "Created To"
              },
              "updated_from": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Updated on or after (UTC).",
                "title": "Updated From"
              },
              "updated_to": {
                "anyOf": [
                  {
                    "format": "date",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "description": "Updated on or before (UTC).",
                "title": "Updated To"
              }
            },
            "title": "TicketSearch",
            "type": "object"
          }
        },
        "properties": {
          "filters": {
            "$ref": "#/$defs/TicketSearch"
          },
          "page": {
            "default": 1,
            "description": "1-based page, max 10.",
            "maximum": 10,
            "minimum": 1,
            "title": "Page",
            "type": "integer"
          }
        },
        "required": [
          "filters"
        ],
        "title": "search_ticketsArguments",
        "type": "object"
      },
      "outputSchema": {
        "$defs": {
          "TicketSummary": {
            "properties": {
              "id": {
                "title": "Id",
                "type": "integer"
              },
              "subject": {
                "title": "Subject",
                "type": "string"
              },
              "status": {
                "description": "open, pending, resolved, closed, or custom_<code>.",
                "title": "Status",
                "type": "string"
              },
              "priority": {
                "title": "Priority",
                "type": "string"
              },
              "type": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Type"
              },
              "requester_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Requester Id"
              },
              "responder_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "description": "Assigned agent id, if any.",
                "title": "Responder Id"
              },
              "group_id": {
                "anyOf": [
                  {
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Group Id"
              },
              "tags": {
                "items": {
                  "type": "string"
                },
                "title": "Tags",
                "type": "array"
              },
              "created_at": {
                "format": "date-time",
                "title": "Created At",
                "type": "string"
              },
              "updated_at": {
                "format": "date-time",
                "title": "Updated At",
                "type": "string"
              },
              "due_by": {
                "anyOf": [
                  {
                    "format": "date-time",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Due By"
              }
            },
            "required": [
              "id",
              "subject",
              "status",
              "priority",
              "type",
              "requester_id",
              "responder_id",
              "group_id",
              "tags",
              "created_at",
              "updated_at",
              "due_by"
            ],
            "title": "TicketSummary",
            "type": "object"
          }
        },
        "properties": {
          "items": {
            "items": {
              "$ref": "#/$defs/TicketSummary"
            },
            "title": "Items",
            "type": "array"
          },
          "page": {
            "title": "Page",
            "type": "integer"
          },
          "has_more": {
            "description": "Call again with page + 1 to get more.",
            "title": "Has More",
            "type": "boolean"
          },
          "total": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Total matches, when Freshdesk reports it.",
            "title": "Total"
