# Copy to .env and fill in the two required values. Never commit .env.

# Required. Subdomain of your helpdesk, e.g. "acme" for acme.freshdesk.com
FRESHDESK_DOMAIN=
# Required. Freshdesk: profile picture -> Profile settings -> View API key
FRESHDESK_API_KEY=

# Optional. Defaults shown.
# FRESHDESK_TIMEOUT_SECONDS=10
# FRESHDESK_MAX_RETRIES=3
# FRESHDESK_RETRY_BACKOFF_SECONDS=0.5
# FRESHDESK_MAX_RETRY_WAIT_SECONDS=30
# Starting quota; the connector adjusts it from Freshdesk's rate-limit headers.
# FRESHDESK_RATE_LIMIT_PER_MINUTE=50
# FRESHDESK_MAX_CONCURRENCY=4
# Set to 0 to disable caching.
# FRESHDESK_CACHE_TTL_SECONDS=60
# FRESHDESK_CACHE_MAX_ENTRIES=1024
# FRESHDESK_SESSION_CALL_BUDGET=200
# FRESHDESK_DEFAULT_PAGE_SIZE=30
# FRESHDESK_MAX_TEXT_CHARS=2000
# FRESHDESK_MASK_PII=true
# FRESHDESK_LOG_LEVEL=INFO
